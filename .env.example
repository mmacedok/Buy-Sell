# Copie para .env e preencha. As chaves ficam somente no backend.

# "live" usa as APIs reais; "mock" usa dados sintéticos (claramente marcados) para testar o fluxo.
DATA_MODE=live

# Notícias
FINNHUB_API_KEY=

# Preços (Alpaca Basic, feed IEX)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_FEED=iex

# SEC/EDGAR exige um User-Agent identificável (nome + e-mail)
SEC_USER_AGENT="Dashboard Ficticia seu-email@exemplo.com"

# OpenRouter (toda a IA)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Endpoint de decisões do JEV (conferir na documentação no momento da implantação)
JEV_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
JEV_MODEL=typesafe/jev-1.13
ANALYST_MODEL=anthropic/claude-sonnet-5

# Orçamento de IA em US$
AI_BUDGET_DAILY_USD=2
AI_BUDGET_MONTHLY_USD=30

PORT=8787
DB_PATH=data/app.db
